# ============================================
# VocazAI environment variables (copy to .env.local)
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vapi (https://vapi.ai) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- Retell (https://retellai.com) ---
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email / Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="VocazAI <contact@vocazai.com>"
CONTACT_TO_EMAIL=contact@vocazai.com
